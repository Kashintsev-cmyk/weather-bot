# ==== Точка прогноза (город Адлер, Сочи) ====
WEATHER_CITY=Адлер
WEATHER_LAT=43.427292
WEATHER_LON=39.917107

# Часовой пояс и горизонт прогноза (дней)
WEATHER_TIMEZONE=Europe/Moscow
FORECAST_DAYS=3

# ==== Ключи площадок ====
# OpenWeatherMap: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# ==== Телеграм ====
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Необязательный белый список chat_id (через запятую). Пусто = доступ всем.
TELEGRAM_ALLOWED_CHAT_IDS=

# Таймаут HTTP-запросов к площадкам, секунды
REQUEST_TIMEOUT=15
# Отладочный режим: подробное логирование и диагностические детали
DEBUG_MODE=false

# ==== Рассылка: ежедневная сводка и оповещения о событиях ====
# Полностью выключает и сводку, и оповещения
NOTIFY_EVENTS_ENABLED=true
# Время ежедневной утренней сводки (локальное время точки, ЧЧ:ММ)
NOTIFY_DAILY_TIME=07:30
# За сколько минут до начала события присылать оповещение
NOTIFY_EVENT_LEAD_MINUTES=60
# На сколько часов вперёд искать события
NOTIFY_EVENT_HORIZON_HOURS=12
# Как часто проверять расписание, секунды
NOTIFY_POLL_SECONDS=60
# Сколько времени после NOTIFY_DAILY_TIME ещё допустимо отправить сводку (минуты)
NOTIFY_DAILY_GRACE_MINUTES=180

# Пороги событий (можно подстроить под себя)
NOTIFY_RAIN_MM_PER_HOUR=0.2
NOTIFY_RAIN_PROBABILITY=55
NOTIFY_GUST_KMH=55
NOTIFY_HURRICANE_GUST_KMH=90
NOTIFY_WAVE_M=1.5
NOTIFY_WAVE_SEVERE_M=2.5
NOTIFY_TEMP_DROP_C=7
NOTIFY_HEAT_C=33
NOTIFY_TORNADO_CAPE=1200

# ==== Землетрясения (USGS, ключ не нужен) ====
EARTHQUAKES_ENABLED=true
EARTHQUAKE_RADIUS_KM=300
EARTHQUAKE_MIN_MAGNITUDE=3
EARTHQUAKE_DAYS=14
# Магнитуда, при которой сообщаем о возможном риске цунами
TSUNAMI_MAGNITUDE=6.5

# Файл состояния: подписки на рассылку и уже отправленные уведомления
STATE_FILE=state/bot_state.json
